{
	"name": "tarosky/pubpla-gatekeeper",
	"description": "Keep privileged accounts accountable: tiered login protection, dormant account isolation, and breached-password checks for WordPress.",
	"type": "wordpress-plugin",
	"minimum-stability": "stable",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs --standard=phpcs.ruleset.xml",
		"fix": "phpcbf --standard=phpcs.ruleset.xml",
		"phpstan": "phpstan analyse --memory-limit=1G"
	},
	"authors": [
		{
			"name": "TAROSKY INC.",
			"email": "info@tarosky.co.jp"
		}
	],
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.0",
		"wp-coding-standards/wpcs": "^3.0",
		"yoast/phpunit-polyfills": "^4.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpstan/phpstan": "^2.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"php-stubs/wordpress-stubs": "^6.9"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "7.4"
		}
	}
}
